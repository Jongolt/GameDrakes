-- - Music by the game moment: own ElevenLabs music (our rights, usable in ads too).
-- - Like the studios (Zelda BotW, Minecraft, Animal Crossing): nature always sounds (Content.Ambience), music on top and rarer -
-- - after a track a pause of gap seconds with nature only; an own track per day phase and per event.
-- - The priority (Controllers/Sounds): boss (the Storm dragon) > storm > starfall (and Aurora) > flight > the DayCycle.Phase phase;
-- - intro - once at the entry. The files are leveled to -19.5 LUFS, fades 0.5/3 s; gain - a fine correction. id - assets_audio.json.
Content.Music = {
	states = {
		-- no plucked guitar tracks: the entry, the flight, the Storm dragon - without music; nature (Content.Ambience) and the event sounds remain
		intro = {},
		-- day / dawn / dusk / night without music, nature sounds only (Content.Ambience)
		day = {},
		dawn = {},
		dusk = {},
		night = {},
		flight = {},
		-- the event music is off too (while playing - only nature); the rain in a storm stays - Content.Ambience
		storm = {},
		starfall = {},
		boss = {},
		-- the fight with the Gloom - an own tense loop of 60 s; win / winSec - the win phrase in the key of the track after a cleared wave (Sounds.fightWin);
		-- the variants A and C (with the win phrases) are commented out below.
		-- The escape loop "the sly thief" (piano, staccato strings, light drums, ~140 BPM; -19.8 LUFS) plays while a raid/golden egg is in the hands or
		-- the guard chases (the Chase attribute from Controllers/Combat)
		chase = {
			{ id = 118258729946884, gain = 1 },
		},
		-- no music in the skirmish (nature and the combat sounds), no win phrase either; the previous is commented out below
		fight = {
			-- { id = 70406877413972, gain = 1, win = 88533814202542, winSec = 6.9 }, -- A: taiko and frame drums, staccato strings, cello, brass; minor, 138 BPM; the win - brass over taiko
			-- { id = 122122871722371, gain = 1, win = 115216657381233, winSec = 5.9 }, -- C: tribal drums, a tense kalimba in minor, a deep bass; 128 BPM; the win - the kalimba into major
		},
	},
