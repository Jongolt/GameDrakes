local function smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- the hill above the area (studs above base); 0 outside the radius
function SpringsShape.hill(x: number, z: number): number
	local M, B = SpringsShape.mound, SpringsShape.box
	local d = math.sqrt((x - M.x) ^ 2 + (z - M.z) ^ 2) / M.r
	if d >= 1 then
		return 0
	end
	local edge = math.min(x - B.x1, B.x2 - x, z - B.z1, B.z2 - z)
	return M.h * (1 - d) ^ M.pow * (1 - 0.25 * math.exp(-(d / 0.12) ^ 2)) * smooth(edge / M.fade)
end

-- the radius of the bowl's inner edge by angle (degrees, like Layout.dir)
function SpringsShape.rin(b: any, thetaDeg: number): number
	local n = #b.rin
	local i = (thetaDeg % 360) / b.step
	local i0 = math.floor(i)
	local f = i - i0
	local a = b.rin[(i0 % n) + 1]
	local c = b.rin[((i0 + 1) % n) + 1]
	return a + (c - a) * f
end

-- the bowl the point (x, z) falls into with a margin of margin beyond the outer rim edge; nil - outside the bowls
function SpringsShape.basinAt(x: number, z: number, margin: number?): any?
	for _, b in SpringsShape.basins do
		local dx, dz = x - b.x, z - b.z
		local r = math.sqrt(dx * dx + dz * dz)
		if r <= SpringsShape.rin(b, math.deg(math.atan2(-dz, dx))) + SpringsShape.lip + (margin or 0) then
			return b
		end
	end
	return nil
end

return SpringsShape
