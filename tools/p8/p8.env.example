# P8 machine settings - a SAMPLE. The real file: ~/.config/p8/p8.env (or the path in the P8_ENV variable), chmod 600, never commit it.
# Read by tools/p8/common.sh (bash source) and tools/p8/mcp_session.py (KEY=VALUE lines, no substitutions).
P8_INSTANCE=i-0123456789abcdef0          # EC2 instance id (g4dn.xlarge Windows, Roblox Studio + noVNC)
P8_REGION=eu-central-1
P8_SG=sg-0123456789abcdef0               # security group: inbound 22 and 6080-6081 only from the build server IP
P8_USER=Administrator
P8_SSH_KEY=/path/to/p8_ssh_key.pem       # SSH key to Windows (OpenSSH)
P8_SECRETS=/path/to/p8_secrets           # lines WINDOWS_PASSWORD=, VNC_PASSWORD=, VNC_CONTROL_PASSWORD=, LAST_PUBLIC_IP=
P8_AWS_ENV=/path/to/.env                 # lines AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=
P8_STATE=/path/to/p8_state               # the machine known_hosts, usage.log (hours of work), mcp_session.err
P8_OUT_ROOT=/path/to/runs                # probes write frames and logs to $P8_OUT_ROOT/roblox_build_<UTC date>/<probe>/
P8_PRICE_HOUR=0.847
# P8_VX=12  P8_VY=176                    # the viewport origin on the P8 screen; without them p8lib.begin() finds it by itself (better not to set)
